# ===========================
# Cloudflare Workers Configuration
# ===========================

# TMDB API Configuration
TMDB_API_KEY=your_tmdb_api_key_here

# Server Configuration
PORT=3000            # Port number for the server (ignored by Workers)
HOST=0.0.0.0         # Use '0.0.0.0' to give LAN/internet access
NODE_ENV=production  # 'development' | 'production'. Production keeps console clean
PUBLIC_URL=https://your-subdomain.workers.dev # The public base URL of your CinePro Core instance

# Stremio Configuration
STREMIO_ADDON=false  # Set to 'true' to enable Stremio addon functionality

# CORS Configuration
CORS_ORIGIN=*        # CORS origin for the server. Set to '*' to allow all origins

# MCP Configuration
MCP_ENABLED=false    # Set to 'true' to enable MCP functionality

# Debug Configuration
INTERNAL_DEBUG=false # Set to 'true' to get non-playable sources too (recommended: false)

# Cache Configuration
CACHE_TYPE=memory    # For Cloudflare Workers: 'memory' (recommended) | 'redis'

# Redis Configuration (only needed if CACHE_TYPE=redis)
REDIS_HOST=localhost # Redis host
REDIS_PORT=6379      # Redis port
REDIS_PASSWORD=      # Redis password if required

# ===========================
# Cloudflare KV Namespace
# ===========================
# Get these from your Cloudflare dashboard
CINEPRO_CACHE_ID=your_kv_namespace_id
CINEPRO_CACHE_PREVIEW_ID=your_kv_preview_id
